# Environment Configuration for Interview Mentor Express Backend

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/interview_mentor
MONGODB_SIMULATOR_URI=mongodb://localhost:27017/interview_mentor_simulator

# JWT Configuration
JWT_SECRET_KEY=change_me_to_a_long_random_string

# AI Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=12
