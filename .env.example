# Interview Mentor Environment Variables

# Google Gemini API Key (required for AI code review with Gemini)
# Get your API key from https://ai.google.dev/ or https://makersuite.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key (change this to a random string for production)
FLASK_SECRET_KEY=your_secret_key_here

# Database Configuration (optional - defaults to SQLite)
# DATABASE_URL=sqlite:///interview_mentor.db

# Debug Mode (set to False in production)
DEBUG=True 